# Copy to backend/.env and fill in. backend/.env is gitignored: never commit keys.

# mock | live | mock_error | mock_timeout | mock_malformed
LLM_MODE=mock

# OpenRouter key and model id (only used when LLM_MODE=live)
LLM_API_KEY=
LLM_MODEL=

# Let the model reason before replying (slower). off | on
LLM_REASONING=off

# Live calls allowed per server process before switching to mock
LLM_MAX_CALLS=50

# Optional. Defaults to backend/skills.db
# SKILLS_DB_PATH=skills.db
